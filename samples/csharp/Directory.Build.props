<Project>

  <PropertyGroup>
    <!--
      AziHSM is only available on Windows, and the AziHSM KSP is a 64-bit
      provider. Projects target Windows/x64 by default; pipeline builds can
      override the runtime and platform target for Windows/Arm64.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Some NCrypt parameter structures contain pointers to caller-owned buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Samples are self-contained demos; nothing here is meant to be packaged. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Keep the sample-facing names concise while sourcing their definitions from
    the Windows metadata generated by CsWin32 in AziHsm.Samples.Common.
  -->
  <ItemGroup>
    <Using Include="Windows.Win32" />
    <Using Include="Windows.Win32.Security.Cryptography" />
    <Using Include="Windows.Win32.NCryptNative" Alias="NCryptConstants" />
    <Using Include="Windows.Win32.NCryptFreeObjectSafeHandle" Alias="NCryptHandle" />
    <Using Include="Windows.Win32.NCryptFreeObjectSafeHandle" Alias="NCryptProviderHandle" />
    <Using Include="Windows.Win32.NCryptFreeObjectSafeHandle" Alias="NCryptKeyHandle" />
    <Using Include="Windows.Win32.NCryptFreeObjectSafeHandle" Alias="NCryptSecretHandle" />
    <Using Include="Windows.Win32.Security.Cryptography.BCryptBuffer" Alias="NCryptBuffer" />
    <Using Include="Windows.Win32.Security.Cryptography.BCryptBufferDesc" Alias="NCryptBufferDesc" />
    <Using Include="Windows.Win32.Security.Cryptography.NCRYPT_CIPHER_PADDING_INFO" Alias="NCryptCipherPaddingInfo" />
    <Using Include="Windows.Win32.Security.Cryptography.BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO" Alias="BCryptAuthenticatedCipherModeInfo" />
    <Using Include="Windows.Win32.Security.Cryptography.BCRYPT_KEY_LENGTHS_STRUCT" Alias="BCryptKeyLengthsStruct" />
    <Using Include="Windows.Win32.Security.Cryptography.BCRYPT_PKCS1_PADDING_INFO" Alias="BCryptPkcs1PaddingInfo" />
    <Using Include="Windows.Win32.Security.Cryptography.BCRYPT_OAEP_PADDING_INFO" Alias="BCryptOaepPaddingInfo" />
  </ItemGroup>

</Project>
